{
  "identifier": "default",
  "description": "SiliconSheep default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-execute",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:webview:allow-create-webview-window"
  ]
}
